BIND_ADDR=127.0.0.1:8080
# Generate with: cargo run -p app -- hash-password '<your password>'
AUTH_PASSWORD_HASH=
# Set to false only for local development over plain HTTP
COOKIE_SECURE=false
RULES_DIR=rules
CATALOG_DIR=catalog
FRONTEND_DIR=frontend/dist
# Runner (optional; without it plans can be exported but not run)
# RUNNER_URL=https://<runner-ip>:9090
# RUNNER_TOKEN=
# RUNNER_CA_CERT=/etc/sectestgen/runner-ca.pem
MAX_UPLOAD_MB=200
